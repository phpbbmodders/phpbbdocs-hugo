<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE article PUBLIC "-//OASIS//DTD DocBook EBNF Module V1.1CR1//EN"
                  "http://www.oasis-open.org/docbook/xml/mathml/1.1CR1/dbmathml.dtd">
<article>
  <articleinfo>
    <title>Tutorial: Autentificering</title>
  </articleinfo>
  <sect1 id="introduction">
    <title>Introduktion</title>
    <para>
      phpBB 3.1 introducerede indbyggede autentificeringsplugins, som du
      kan udvide eller oprette dine egne af.
    </para>
    <para>
      Denne tutorial forklarer:
    </para>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          <link linkend="authentication-providers">Authentication
          Providers</link>
        </para>
      </listitem>
      <listitem>
        <para>
          <link linkend="oauth-providers">OAuth Providers</link>
        </para>
      </listitem>
    </itemizedlist>
  </sect1>
  <sect1 id="authentication-providers">
    <title>Authentication Providers</title>
    <para>
      phpBB 3.1 introducerede understøttelse af eksterne
      autentificeringsplugins, som kan bruges i stedet for de indbyggede
      authentication providers. Kun én provider kan for øjeblikket være
      aktiv ad gangen, og den aktive vælges fra ACP'en.
    </para>
    <sect2 id="creating-an-authentication-provider">
      <title>Oprettelse af en authentication provider</title>
      <para>
        Authentication providers i phpBB kræver mindst to filer: en
        PHP-klasse og en YAML-servicefil.
      </para>
      <sect3 id="the-class-file">
        <title>Klassefilen</title>
        <para>
          Provider-klassen skal implementere
          <literal>\phpbb\auth\provider\provider_interface</literal> for
          at sikre korrekt funktionalitet. Det anbefales dog at udvide
          <literal>\phpbb\auth\provider\base</literal> for ikke at skulle
          implementere unødvendige metoder og for at sikre, at provideren
          ikke går i stykker på grund af en opdatering af interfacet. Et
          eksempel på en authentication provider-klasse ses nedenfor:
        </para>
        <programlisting>
&lt;?php

namespace acme\demo\auth\provider;

/**
 * Database authentication provider for phpBB3
 *
 * This is for authentication via the integrated user table
 */
class db2 extends \phpbb\auth\provider\base
{
    /** @var \phpbb\db\driver\driver_interface $db */
    protected $db;

    /**
     * Database Authentication Constructor
     *
     * @param \phpbb\db\driver\driver_interface $db
     */
    public function __construct(\phpbb\db\driver\driver_interface $db)
    {
        $this-&gt;db = $db;
    }

    /**
     * {@inheritdoc}
     */
    public function login($username, $password)
    {
        // Auth plugins get the password untrimmed.
        // For compatibility we trim() here.
        $password = trim($password);

        // do not allow empty password
        if (!$password)
        {
            return [
                'status'    =&gt; LOGIN_ERROR_PASSWORD,
                'error_msg' =&gt; 'NO_PASSWORD_SUPPLIED',
                'user_row'  =&gt; ['user_id' =&gt; ANONYMOUS],
            ];
        }

        if (!$username)
        {
            return [
                'status'    =&gt; LOGIN_ERROR_USERNAME,
                'error_msg' =&gt; 'LOGIN_ERROR_USERNAME',
                'user_row'  =&gt; ['user_id' =&gt; ANONYMOUS],
            ];
        }

        $username_clean = utf8_clean_string($username);

        $sql = 'SELECT user_id, username, user_password, user_passchg, user_pass_convert, user_email, user_type, user_login_attempts
            FROM ' . USERS_TABLE . &quot;
            WHERE username_clean = '&quot; . $this-&gt;db-&gt;sql_escape($username_clean) . &quot;'&quot;;
        $result = $this-&gt;db-&gt;sql_query($sql);
        $row = $this-&gt;db-&gt;sql_fetchrow($result);
        $this-&gt;db-&gt;sql_freeresult($result);

        // Successful login... set user_login_attempts to zero...
        return [
            'status'    =&gt; LOGIN_SUCCESS,
            'error_msg' =&gt; false,
            'user_row'  =&gt; $row,
        ];
    }
}
</programlisting>
      </sect3>
      <sect3 id="the-service-file">
        <title>Servicefilen</title>
        <para>
          For korrekt
          <literal>dependency injection &lt;dependency-injection&gt;</literal>
          skal provideren tilføjes til <literal>services.yml</literal>.
          Navnet på servicen skal have formen
          <literal>auth.provider.&lt;service name&gt;</literal>, for at
          phpBB kan registrere den. Argumenterne er dem, der hører til
          providerens konstruktør, og kan være tomme, hvis ingen
          argumenter er nødvendige. Provideren skal tagges med
          <literal>{ name: auth.provider }</literal>, for at klassen kan
          gøres tilgængelig i phpBB.
        </para>
        <programlisting language="yaml">
services:
    auth.provider.db2:
        class: acme\demo\auth\provider\db2
        arguments:
            - '@dbal.conn'
        tags:
            - { name: auth.provider }
</programlisting>
      </sect3>
      <sect3 id="the-template-file">
        <title>Skabelonfilen</title>
        <para>
          Følges trinnene ovenfor, gøres authentication provideren
          synlig i ACP'en. For at give en administrator mulighed for at
          konfigurere dit plugin skal de tilgængelige felter dog
          oprettes, så konfigurationen kan tilgås fra
          php-auth-provider-pluginet. Dette interface konfigureres i
          HTML-format i
          <literal>adm/style/auth_provider_&lt;providername&gt;.html</literal>.
        </para>
        <para>
          Eksemplet nedenfor er f.eks. baseret på eksisterende
          LDAP-termer, der bruges til at konfigurere en HTTPS-server:
        </para>
        <programlisting language="html">
&lt;fieldset id=&quot;auth_test_settings&quot;&gt;
    &lt;legend&gt;{{ TEST }}&lt;/legend&gt;
    &lt;dl&gt;
        &lt;dt&gt;&lt;label for=&quot;https_server&quot;&gt;{{ TEST_SERVER ~ lang('COLON') }}&lt;/label&gt;&lt;br /&gt;&lt;span&gt;{{ TEST_SERVER_EXPLAIN }}&lt;/span&gt;&lt;/dt&gt;
        &lt;dd&gt;&lt;input type=&quot;text&quot; id=&quot;https_server&quot; size=&quot;40&quot; name=&quot;config[https_server]&quot; value=&quot;{{ AUTH_HTTPS_SERVER }}&quot; /&gt;&lt;/dd&gt;
    &lt;/dl&gt;
&lt;/fieldset&gt;
</programlisting>
        <para>
          Denne værdi kan derefter hentes fra filen
          <literal>&lt;provider&gt;.php</literal> sådan her:
        </para>
        <programlisting>
$domain = $this-&gt;config['https_server'];
</programlisting>
      </sect3>
    </sect2>
  </sect1>
  <sect1 id="oauth-providers">
    <title>OAuth Providers</title>
    <para>
      phpBB 3.1 leveres med en ny authentication provider: OAuth. Denne
      provider er baseret på biblioteket
      <ulink url="https://github.com/Lusitanian/PHPoAuthLib">Lusitanian/PHPoAuthLib</ulink>.
    </para>
    <sect2 id="enabling-an-oauth-provider">
      <title>Aktivering af en OAuth provider</title>
      <para>
        For at aktivere en ny OAuth-service i phpBB skal du blot oprette
        to filer i din extension. Klassefilen, der definerer den
        funktionalitet, phpBB har brug for til at hente de data, det
        skal bruge fra servicen, og servicefilen, der giver phpBB
        mulighed for at finde klassen. For at finde ud af, hvordan du
        sandsynligvis bør foretage kald til OAuth-servicen, anbefales
        det, at du kigger på de inkluderede OAuth-services og på
        eksemplerne fra
        <ulink url="https://github.com/Lusitanian/PHPoAuthLib">Lusitanian/PHPoAuthLib</ulink>.
      </para>
      <para>
        Eksempelfilerne nedenfor viser det mindste, der skal til for at
        aktivere en OAuth-service i phpBB. De er kopier af
        bitly-service-implementeringen fra phpBB3's develop-branch.
      </para>
      <sect3 id="the-class-file-1">
        <title>Klassefilen</title>
        <programlisting>
&lt;?php
/**
*
* This file is part of the phpBB Forum Software package.
*
* @copyright (c) phpBB Limited &lt;https://www.phpbb.com&gt;
* @license GNU General Public License, version 2 (GPL-2.0)
*
* For full copyright and license information, please see
* the docs/CREDITS.txt file.
*
*/

namespace phpbb\auth\provider\oauth\service;

/**
* Bitly OAuth service
*/
class bitly extends \phpbb\auth\provider\oauth\service\base
{
    /**
    * phpBB config
    *
    * @var \phpbb\config\config
    */
    protected $config;

    /**
    * phpBB request
    *
    * @var \phpbb\request\request_interface
    */
    protected $request;

    /**
    * Constructor
    *
    * @param    \phpbb\config\config               $config
    * @param    \phpbb\request\request_interface   $request
    */
    public function __construct(\phpbb\config\config $config, \phpbb\request\request_interface $request)
    {
        $this-&gt;config = $config;
        $this-&gt;request = $request;
    }

    /**
    * {@inheritdoc}
    */
    public function get_service_credentials()
    {
        return [
            'key'     =&gt; $this-&gt;config['auth_oauth_bitly_key'],
            'secret'  =&gt; $this-&gt;config['auth_oauth_bitly_secret'],
        ];
    }

    /**
    * {@inheritdoc}
    */
    public function perform_auth_login()
    {
        if (!($this-&gt;service_provider instanceof \OAuth\OAuth2\Service\Bitly))
        {
            throw new \phpbb\auth\provider\oauth\service\exception('AUTH_PROVIDER_OAUTH_ERROR_INVALID_SERVICE_TYPE');
        }

        // This was a callback request from bitly, get the token
        $this-&gt;service_provider-&gt;requestAccessToken($this-&gt;request-&gt;variable('code', ''));

        // Send a request with it
        $result = json_decode($this-&gt;service_provider-&gt;request('user/info'), true);

        // Return the unique identifier returned from bitly
        return $result['data']['login'];
    }

    /**
    * {@inheritdoc}
    */
    public function perform_token_auth()
    {
        if (!($this-&gt;service_provider instanceof \OAuth\OAuth2\Service\Bitly))
        {
            throw new \phpbb\auth\provider\oauth\service\exception('AUTH_PROVIDER_OAUTH_ERROR_INVALID_SERVICE_TYPE');
        }

        // Send a request with it
        $result = json_decode($this-&gt;service_provider-&gt;request('user/info'), true);

        // Return the unique identifier returned from bitly
        return $result['data']['login'];
    }
}
</programlisting>
      </sect3>
      <sect3 id="the-service-file-1">
        <title>Servicefilen</title>
        <para>
          I servicefilen skal navnet på servicen have formen
          <literal>auth.provider.oauth.service.&lt;service name&gt;</literal>,
          for at phpBB kan genkende den korrekt.
        </para>
        <programlisting language="yaml">
services:
    auth.provider.oauth.service.bitly:
        class: phpbb\auth\provider\oauth\service\bitly
        arguments:
            - '@config'
            - '@request'
        tags:
            - { name: auth.provider.oauth.service }
</programlisting>
      </sect3>
    </sect2>
  </sect1>
</article>
