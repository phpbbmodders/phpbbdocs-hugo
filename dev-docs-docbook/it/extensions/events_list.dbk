            </entry>
          </row>
          <row>
            <entry>
              core.modify_text_for_display_before
            </entry>
            <entry>
              includes/functions_content.php
            </entry>
            <entry>
              bitfield, censor_text, flags, text, uid
            </entry>
            <entry>
              3.1.0-a1
            </entry>
            <entry>
              Usa questo evento per modificare il testo prima che venga
              analizzato
            </entry>
          </row>
          <row>
            <entry>
              core.modify_text_for_edit_after
            </entry>
            <entry>
              includes/functions_content.php
            </entry>
            <entry>
              flags, text
            </entry>
            <entry>
              3.1.0-a1
            </entry>
            <entry>
              Usa questo evento per modificare il testo dopo che è stato
