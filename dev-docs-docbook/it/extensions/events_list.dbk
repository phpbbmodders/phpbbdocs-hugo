  <sect1 id="template-events">
    <title>Eventi template</title>
    <informaltable>
      <tgroup cols="4">
        <colspec colwidth="20*" align="left" />
        <colspec colwidth="22*" align="left" />
        <colspec colwidth="7*" align="left" />
        <colspec colwidth="49*" align="left" />
        <thead>
          <row>
            <entry>
              Identificatore
            </entry>
            <entry>
              Posizione in Prosilver (se applicabile)
            </entry>
            <entry>
              Aggiunto nella release
            </entry>
            <entry>
              Spiegazione
            </entry>
          </row>
        </thead>
        <tbody>
<!--INSERT_TEMPLATE_EVENTS_HERE-->
        </tbody>
      </tgroup>
    </informaltable>
  </sect1>
  <sect1 id="acp-template-events">
    <title>Eventi template ACP</title>
    <informaltable>
      <tgroup cols="4">
        <colspec colwidth="20*" align="left" />
        <colspec colwidth="11*" align="left" />
        <colspec colwidth="7*" align="left" />
        <colspec colwidth="59*" align="left" />
        <thead>
          <row>
            <entry>
              Identificatore
            </entry>
            <entry>
              Posizione
            </entry>
            <entry>
              Aggiunto nella release
            </entry>
            <entry>
              Spiegazione
            </entry>
          </row>
        </thead>
        <tbody>
