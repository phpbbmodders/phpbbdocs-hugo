            <entry>
              action, is_valid_action, module
            </entry>
            <entry>
              3.1.0-a4
            </entry>
            <entry>
              Questo evento ti permette di aggiungere opzioni quickmod
              personalizzate
            </entry>
          </row>
          <row>
            <entry>
              core.modify_submit_notification_data
