            <entry>
              includes/functions_posting.php
            </entry>
            <entry>
              data, mode, poll, subject, topic_type, update_message,
              update_search_index, username
            </entry>
            <entry>
              3.1.0-a4
            </entry>
            <entry>
              Modifica i dati per l'invio del messaggio
            </entry>
          </row>
          <row>
            <entry>
              core.modify_text_for_display_after
            </entry>
            <entry>
              includes/functions_content.php
            </entry>
            <entry>
              bitfield, flags, text, uid
            </entry>
            <entry>
              3.1.0-a1
            </entry>
            <entry>
              Usa questo evento per modificare il testo dopo che è stato
