            <entry>
              includes/functions_posting.php
            </entry>
            <entry>
              data_ary, mode, notification_data, poster_id
            </entry>
            <entry>
              3.2.4-RC1
            </entry>
            <entry>
              Questo evento ti permette di modificare i dati di notifica
              all'invio
            </entry>
          </row>
          <row>
            <entry>
              core.modify_submit_post_data
