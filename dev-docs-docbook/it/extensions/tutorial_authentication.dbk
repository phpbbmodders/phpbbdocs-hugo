<?xml version="1.0" encoding="utf-8" ?>
<!DOCTYPE article PUBLIC "-//OASIS//DTD DocBook EBNF Module V1.1CR1//EN"
                  "http://www.oasis-open.org/docbook/xml/mathml/1.1CR1/dbmathml.dtd">
<article>
  <articleinfo>
    <title>Tutorial: Autenticazione</title>
  </articleinfo>
  <sect1 id="introduction">
    <title>Introduzione</title>
    <para>
      phpBB 3.1 ha introdotto plugin di autenticazione integrati che
      puoi estendere o crearne di tuoi.
    </para>
    <para>
      Questo tutorial spiega:
    </para>
    <itemizedlist spacing="compact">
      <listitem>
        <para>
          <link linkend="authentication-providers">Provider di
          autenticazione</link>
        </para>
      </listitem>
      <listitem>
        <para>
          <link linkend="oauth-providers">Provider OAuth</link>
        </para>
      </listitem>
    </itemizedlist>
  </sect1>
  <sect1 id="authentication-providers">
    <title>Provider di autenticazione</title>
    <para>
      phpBB 3.1 ha introdotto il supporto per plugin di autenticazione
      esterni che possono essere usati al posto dei provider di
      autenticazione integrati. Attualmente può essere attivo un solo
      provider alla volta e quello attivo viene scelto dall'ACP.
    </para>
    <sect2 id="creating-an-authentication-provider">
      <title>Creare un provider di autenticazione</title>
      <para>
        I provider di autenticazione in phpBB richiedono un minimo di
        due file: una classe PHP e un file di servizio YAML.
      </para>
      <sect3 id="the-class-file">
        <title>Il file della classe</title>
        <para>
          La classe del provider deve implementare
          <literal>\phpbb\auth\provider\provider_interface</literal>
          per garantire il corretto funzionamento. Tuttavia, si
          raccomanda di estendere
          <literal>\phpbb\auth\provider\base</literal> in modo da non
          implementare metodi non necessari e per garantire che il
          provider non si interrompa a causa di un aggiornamento
          dell'interfaccia. Un esempio di classe provider di
          autenticazione è mostrato di seguito:
        </para>
        <programlisting>
&lt;?php

namespace acme\demo\auth\provider;

/**
 * Database authentication provider for phpBB3
 *
 * This is for authentication via the integrated user table
 */
class db2 extends \phpbb\auth\provider\base
{
    /** @var \phpbb\db\driver\driver_interface $db */
    protected $db;

    /**
     * Database Authentication Constructor
     *
     * @param \phpbb\db\driver\driver_interface $db
     */
    public function __construct(\phpbb\db\driver\driver_interface $db)
    {
        $this-&gt;db = $db;
    }

    /**
     * {@inheritdoc}
     */
    public function login($username, $password)
    {
        // Auth plugins get the password untrimmed.
        // For compatibility we trim() here.
        $password = trim($password);

        // do not allow empty password
        if (!$password)
        {
            return [
                'status'    =&gt; LOGIN_ERROR_PASSWORD,
                'error_msg' =&gt; 'NO_PASSWORD_SUPPLIED',
                'user_row'  =&gt; ['user_id' =&gt; ANONYMOUS],
            ];
        }

        if (!$username)
        {
            return [
                'status'    =&gt; LOGIN_ERROR_USERNAME,
                'error_msg' =&gt; 'LOGIN_ERROR_USERNAME',
                'user_row'  =&gt; ['user_id' =&gt; ANONYMOUS],
            ];
        }

        $username_clean = utf8_clean_string($username);

        $sql = 'SELECT user_id, username, user_password, user_passchg, user_pass_convert, user_email, user_type, user_login_attempts
            FROM ' . USERS_TABLE . &quot;
            WHERE username_clean = '&quot; . $this-&gt;db-&gt;sql_escape($username_clean) . &quot;'&quot;;
        $result = $this-&gt;db-&gt;sql_query($sql);
        $row = $this-&gt;db-&gt;sql_fetchrow($result);
        $this-&gt;db-&gt;sql_freeresult($result);

        // Successful login... set user_login_attempts to zero...
        return [
            'status'    =&gt; LOGIN_SUCCESS,
            'error_msg' =&gt; false,
            'user_row'  =&gt; $row,
        ];
    }
}
</programlisting>
      </sect3>
      <sect3 id="the-service-file">
        <title>Il file di servizio</title>
        <para>
          Per una corretta
          <literal>dependency injection &lt;dependency-injection&gt;</literal>
          il provider deve essere aggiunto a
          <literal>services.yml</literal>. Il nome del servizio deve
          essere nella forma
          <literal>auth.provider.&lt;nome servizio&gt;</literal>
          affinché phpBB lo registri. Gli argomenti sono quelli del
          costruttore del provider e possono essere vuoti se non sono
          necessari argomenti. Il provider deve essere contrassegnato
          con <literal>{ name: auth.provider }</literal> affinché la
          classe sia resa disponibile in phpBB.
        </para>
        <programlisting language="yaml">
services:
    auth.provider.db2:
        class: acme\demo\auth\provider\db2
        arguments:
            - '@dbal.conn'
        tags:
            - { name: auth.provider }
</programlisting>
      </sect3>
      <sect3 id="the-template-file">
        <title>Il file template</title>
        <para>
          Seguendo i passaggi sopra il provider di autenticazione
          diventa visibile nell'ACP. Tuttavia, per permettere a un
          amministratore di configurare il tuo plugin è necessario
          creare i campi disponibili per raggiungere la
          configurazione dal plugin php-auth-provider. Questa
          interfaccia viene configurata in formato HTML in
          <literal>adm/style/auth_provider_&lt;nomeprovider&gt;.html</literal>.
        </para>
        <para>
          Ad esempio, l'esempio sotto si basa su termini LDAP
          esistenti usati per configurare un server HTTPS:
        </para>
        <programlisting language="html">
&lt;fieldset id=&quot;auth_test_settings&quot;&gt;
    &lt;legend&gt;{{ TEST }}&lt;/legend&gt;
    &lt;dl&gt;
        &lt;dt&gt;&lt;label for=&quot;https_server&quot;&gt;{{ TEST_SERVER ~ lang('COLON') }}&lt;/label&gt;&lt;br /&gt;&lt;span&gt;{{ TEST_SERVER_EXPLAIN }}&lt;/span&gt;&lt;/dt&gt;
        &lt;dd&gt;&lt;input type=&quot;text&quot; id=&quot;https_server&quot; size=&quot;40&quot; name=&quot;config[https_server]&quot; value=&quot;{{ AUTH_HTTPS_SERVER }}&quot; /&gt;&lt;/dd&gt;
    &lt;/dl&gt;
&lt;/fieldset&gt;
</programlisting>
        <para>
          Questo valore può poi essere recuperato dal file
          <literal>&lt;provider&gt;.php</literal> in questo modo:
        </para>
        <programlisting>
$domain = $this-&gt;config['https_server'];
</programlisting>
      </sect3>
    </sect2>
  </sect1>
  <sect1 id="oauth-providers">
    <title>Provider OAuth</title>
    <para>
      phpBB 3.1 include un nuovo provider di autenticazione: OAuth.
      Questo provider si basa sulla libreria
      <ulink url="https://github.com/Lusitanian/PHPoAuthLib">Lusitanian/PHPoAuthLib</ulink>.
    </para>
    <sect2 id="enabling-an-oauth-provider">
      <title>Abilitare un provider OAuth</title>
      <para>
        Per abilitare un nuovo servizio OAuth in phpBB devi creare
        solo due file nella tua estensione. Il file della classe che
        definisce le funzionalità necessarie affinché phpBB ottenga i
        dati di cui ha bisogno dal servizio, e il file di servizio che
        permette a phpBB di trovare la classe. Per scoprire come
        dovresti probabilmente effettuare chiamate al servizio OAuth,
        si raccomanda di fare riferimento ai servizi OAuth inclusi e
        agli esempi forniti da
        <ulink url="https://github.com/Lusitanian/PHPoAuthLib">Lusitanian/PHPoAuthLib</ulink>.
      </para>
      <para>
        I file di esempio sotto mostrano il minimo necessario per
        abilitare un servizio OAuth in phpBB. Sono copie
        dell'implementazione del servizio bitly dal branch di
        sviluppo di phpBB3.
      </para>
      <sect3 id="the-class-file-1">
        <title>Il file della classe</title>
        <programlisting>
&lt;?php
/**
*
* This file is part of the phpBB Forum Software package.
*
* @copyright (c) phpBB Limited &lt;https://www.phpbb.com&gt;
* @license GNU General Public License, version 2 (GPL-2.0)
*
* For full copyright and license information, please see
* the docs/CREDITS.txt file.
*
*/

namespace phpbb\auth\provider\oauth\service;

/**
* Bitly OAuth service
*/
class bitly extends \phpbb\auth\provider\oauth\service\base
{
    /**
    * phpBB config
    *
    * @var \phpbb\config\config
    */
    protected $config;

    /**
    * phpBB request
    *
    * @var \phpbb\request\request_interface
    */
    protected $request;

    /**
    * Constructor
    *
    * @param    \phpbb\config\config               $config
    * @param    \phpbb\request\request_interface   $request
    */
    public function __construct(\phpbb\config\config $config, \phpbb\request\request_interface $request)
    {
        $this-&gt;config = $config;
        $this-&gt;request = $request;
    }

    /**
    * {@inheritdoc}
    */
    public function get_service_credentials()
    {
        return [
            'key'     =&gt; $this-&gt;config['auth_oauth_bitly_key'],
            'secret'  =&gt; $this-&gt;config['auth_oauth_bitly_secret'],
        ];
    }

    /**
    * {@inheritdoc}
    */
    public function perform_auth_login()
    {
        if (!($this-&gt;service_provider instanceof \OAuth\OAuth2\Service\Bitly))
        {
            throw new \phpbb\auth\provider\oauth\service\exception('AUTH_PROVIDER_OAUTH_ERROR_INVALID_SERVICE_TYPE');
        }

        // This was a callback request from bitly, get the token
        $this-&gt;service_provider-&gt;requestAccessToken($this-&gt;request-&gt;variable('code', ''));

        // Send a request with it
        $result = json_decode($this-&gt;service_provider-&gt;request('user/info'), true);

        // Return the unique identifier returned from bitly
        return $result['data']['login'];
    }

    /**
    * {@inheritdoc}
    */
    public function perform_token_auth()
    {
        if (!($this-&gt;service_provider instanceof \OAuth\OAuth2\Service\Bitly))
        {
            throw new \phpbb\auth\provider\oauth\service\exception('AUTH_PROVIDER_OAUTH_ERROR_INVALID_SERVICE_TYPE');
        }

        // Send a request with it
        $result = json_decode($this-&gt;service_provider-&gt;request('user/info'), true);

        // Return the unique identifier returned from bitly
        return $result['data']['login'];
    }
}
</programlisting>
      </sect3>
      <sect3 id="the-service-file-1">
        <title>Il file di servizio</title>
        <para>
          Nel file di servizio, il nome del servizio deve essere
          nella forma
          <literal>auth.provider.oauth.service.&lt;nome servizio&gt;</literal>
          affinché phpBB lo riconosca correttamente.
        </para>
        <programlisting language="yaml">
services:
    auth.provider.oauth.service.bitly:
        class: phpbb\auth\provider\oauth\service\bitly
        arguments:
            - '@config'
            - '@request'
        tags:
            - { name: auth.provider.oauth.service }
</programlisting>
      </sect3>
    </sect2>
  </sect1>
</article>
